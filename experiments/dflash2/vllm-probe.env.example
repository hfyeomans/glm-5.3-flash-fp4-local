# Candidate only: GPU fit, correctness and speed are not yet measured.
# Use as the isolated worktree's .env; release the serving GPUs before a real launch.
DRAFTER=dflash2
CONTAINER_NAME=glm53-fp4-dflash2-probe
HOST=127.0.0.1
PORT=8002
RUNTIME_VOLUME=glm53-fp4-dflash2-probe
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=1
KV_CACHE_MEMORY_BYTES=3221225472
DFLASH2_NUM_SPECULATIVE_TOKENS=7
DFLASH2_KV_CACHE_DTYPE=auto
