# Literal KEY=value settings. No shell expansion or surrounding quotes.
# Exported environment values take precedence. Never put credentials here.
HF_CACHE_ROOT=/models_engrams/huggingface
# Host HF_HOME and HF_HUB_CACHE are derived from this recipe-specific setting.
# MODEL_DIR=/models_engrams/huggingface/nvidia/glm-5.3-flash-fp4-local
# CPU-staged safetensors passed on this host; InstantTensor failed at MTP loading.
LOAD_FORMAT=safetensors
# Set 0 only for a controlled plain-decoding comparison; default remains MTP3.
MTP_ENABLED=1
MODEL_REVISION=76348ddb2be2e35e39ecfc00e75dc07703f4f3d5
IMAGE=ghcr.io/local-inference-lab/vllm:release-10152026@sha256:745feb916ee816f5409fd58386114be4f22fbede7f9c0e0a7b8c4fe8dac0fb29
CONTAINER_NAME=glm53-fp4-tp2
GPUS=0,1
HOST=0.0.0.0
PORT=8000
SERVED_MODEL_NAME=glm-5.3-flash-fp4-local
RUNTIME_VOLUME=glm53-fp4-runtime-10152026
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=0.985
KV_CACHE_MEMORY_BYTES=7650410496
MIN_GPU_FREE_MIB=96000
WAIT_TIMEOUT=3600
SMOKE_TIMEOUT=180
# First launch stops on failure. Set on-failure:3 after a successful test.
RESTART_POLICY=no
