diff --git a/zig/src/cuda/sm120_tuning.zig b/zig/src/cuda/sm120_tuning.zig
new file mode 100644
index 00000000..e673a00c
--- /dev/null
+++ b/zig/src/cuda/sm120_tuning.zig
@@ -0,0 +1,46 @@
+//! Explicit local tuning controls; unset values preserve the upstream schedule and placement.
+const std = @import("std");
+var split_cached: std.atomic.Value(usize) = .init(0);
+
+pub fn parse(raw: ?[]const u8, fallback: usize, allowed: []const usize) !usize {
+    const value = if (raw) |v| std.fmt.parseInt(usize, v, 10) catch return error.InvalidTuning else fallback;
+    if (std.mem.indexOfScalar(usize, allowed, value) == null) return error.InvalidTuning;
+    return value;
+}
+
+fn number(comptime name: [:0]const u8, fallback: usize, allowed: []const usize) usize {
+    const raw = if (std.c.getenv(name)) |v| std.mem.span(v) else null;
+    return parse(raw, fallback, allowed) catch std.debug.panic("Invalid setting: {s}", .{name});
+}
+
+pub fn splitTarget() usize {
+    const cached = split_cached.load(.monotonic);
+    if (cached != 0) return cached;
+    const value = number("TF_TUNE_SPLIT_TARGET", 192, &.{ 192, 384, 768 });
+    split_cached.store(value, .monotonic);
+    return value;
+}
+
+pub fn promptWidths() [3]usize {
+    return .{ 8, number("TF_TUNE_PREFILL_UP", 4, &.{ 4, 8 }), number("TF_TUNE_PREFILL_DOWN", 8, &.{ 8, 16 }) };
+}
+
+pub fn promptSymbols(widths: [3]usize) [3][:0]const u8 {
+    return .{ "tf_nvfp4_prompt_relu2", if (widths[1] == 8) "tf_nvfp4_prompt_swiglu_w8" else "tf_nvfp4_prompt_swiglu", if (widths[2] == 16) "tf_nvfp4_prompt_down_w16" else "tf_nvfp4_prompt_down" };
+}
+
+pub fn hostEmbed() bool {
+    return number("TF_TUNE_HOST_EMBED", 0, &.{ 0, 1 }) == 1;
+}
+
+pub fn fingerprint() [4]u32 {
+    const widths = promptWidths();
+    return .{ @intCast(widths[1]), @intCast(widths[2]), @intCast(splitTarget()), @intFromBool(hostEmbed()) };
+}
+
+test "local tuning values refuse unsupported schedules" {
+    try std.testing.expectEqual(@as(usize, 192), try parse(null, 192, &.{ 192, 384, 768 }));
+    try std.testing.expectEqual(@as(usize, 384), try parse("384", 192, &.{ 192, 384, 768 }));
+    try std.testing.expectError(error.InvalidTuning, parse("193", 192, &.{ 192, 384, 768 }));
+    try std.testing.expectError(error.InvalidTuning, parse("bad", 192, &.{ 192, 384, 768 }));
+}
diff --git a/zig/src/families/glm/cuda_embed_host.zig b/zig/src/families/glm/cuda_embed_host.zig
new file mode 100644
index 00000000..020487ec
--- /dev/null
+++ b/zig/src/families/glm/cuda_embed_host.zig
@@ -0,0 +1,17 @@
+//! Own immutable BF16 embedding bytes in mapped host memory for the existing gather kernels.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const Owned = struct { buffer: cuda.HostBuffer, ptr: u64 };
+
+pub fn put(loader: anytype) !Owned {
+    var buffer = try cuda.HostBuffer.allocMapped(loader.d, loader.host.items.len);
+    errdefer buffer.free();
+    @memcpy(buffer.bytes, loader.host.items);
+    const ptr = try buffer.device();
+    const name = try loader.gpa.dupe(u8, "embed");
+    errdefer loader.gpa.free(name);
+    try loader.w.named.append(loader.gpa, .{ .name = name, .ptr = ptr, .len = buffer.bytes.len });
+    loader.host.clearRetainingCapacity();
+    return .{ .buffer = buffer, .ptr = ptr };
+}
