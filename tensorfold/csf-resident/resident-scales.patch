+        a.free(t.want);
+        t.want = &.{};
+        a.free(t.active);
+        t.active = &.{};
+        t.shape = s;
+        const tiles = s.n / 32 * (s.k / 32);
+        t.want = try a.alloc(u8, E * M * tiles * 64);
+        var desc: [E * M]cuda.nvfp4_csf32.Descriptor = undefined;
+        const oracle = try a.alloc(u8, t.want.len);
+        defer a.free(oracle);
+        const scale = try a.alloc(u8, s.n * s.k / 16);
+        defer a.free(scale);
+        const decoded = try a.alloc(u8, scale.len);
+        defer a.free(decoded);
+        const codes = try a.alloc(u8, s.n * s.k / 2);
+        defer a.free(codes);
+        @memset(codes, 0);
+        const interleaved = try a.alloc(u32, tiles * 144);
+        defer a.free(interleaved);
+        var prng = std.Random.DefaultPrng.init(seed);
+        for (&desc, 0..) |*d, matrix| {
+            prng.random().bytes(scale);
+            for (scale[0..@min(256, scale.len)], 0..) |*v, i| v.* = @intCast(i);
+            const enc = try codec.encode(a, scale, s.n, s.k / 16);
+            defer enc.deinit(a);
+            try codec.decode(enc.parts(), s.n, s.k / 16, decoded);
+            try check_.sameBytes("CSF fixture CPU decode", decoded, scale);
+            X.packOne(interleaved, codes, decoded, s.n, s.k);
+            for (0..tiles) |tile| {
+                const dest = ((matrix / M * tiles + tile) * M + matrix % M) * 64;
+                @memcpy(t.want[dest..][0..64], std.mem.sliceAsBytes(interleaved[tile * 144 + 128 ..][0..16]));
+            }
+            @import("glm_csf_scale_oracle.zig").writeMatrix(oracle[matrix / M * tiles * M * 64 ..][0 .. tiles * M * 64], decoded, s.k / 16, 0, 0, s.n, s.k, M, matrix % M);
+            d.* = .{ .bases = try t.rig.input(enc.bases), .codes = try t.rig.input(enc.codes), .pages = try t.rig.input(enc.page_bases), .offsets = try t.rig.input(enc.offsets), .exceptions = try t.rig.input(enc.exceptions) };
+        }
+        try check_.sameBytes("CPU scale-only oracle versus legacy packer", oracle, t.want);
+        t.desc = try t.rig.input(std.mem.asBytes(&desc));
+        // Duplicate adjacent plan chunks for expert 2 must have a single writer; expert 1 remains untouched.
+        const items = [9]i32{ 0, 0, 1, 2, 1, 16, 2, 17, 1 };
+        const counts = [2]i32{ 3, 0 };
+        t.plan = .{ .items = try t.rig.input(std.mem.asBytes(&items)), .counts = try t.rig.input(std.mem.asBytes(&counts)), .members = 0, .rank = 0, .hist = 0 };
+        t.out = try t.rig.output(t.want.len);
+        t.active = try a.dupe(u8, t.want);
+        @memset(t.active[M * tiles * 64 ..][0 .. M * tiles * 64], 0);
+        return true;
+    }
+    pub fn run(t: *Test) !void {
+        try cuda.nvfp4_csf32.expand(t.f, t.rig.s, t.desc, t.out, t.plan, t.shape.n, t.shape.k, M, E, 3, true);
+    }
+    pub fn replaced(t: *Test) ![]const u8 {
+        return t.want;
+    }
+    pub fn count(t: *Test) usize {
+        return t.want.len;
+    }
+    pub fn reference(t: *Test, want: []f64, mag: []f64) !void {
+        for (want, t.want) |*v, b| v.* = @floatFromInt(b);
+        @memset(mag, 0);
+    }
+    pub fn check(t: *Test, _: g.Gate) !?[]const u8 {
+        if (!std.mem.eql(u8, try t.rig.outputBytes(), t.want)) return "CSF expanded bytes differ from CPU decode/native pack";
+        return null;
+    }
+    fn routes(t: *Test) !void {
+        try t.rig.zero(t.out, t.want.len);
+        try cuda.nvfp4_csf32.expand(t.f, t.rig.s, t.desc, t.out, t.plan, t.shape.n, t.shape.k, M, E, 4, false);
+        try check_.sameBytes("CSF active and duplicate routes", try t.rig.outputBytes(), t.active);
+        const counts: cuda.DeviceBuffer = .{ .d = t.rig.gpu.d, .ptr = t.plan.counts, .len = 8 };
+        try counts.fill8(0, t.rig.s.handle);
+        try cuda.nvfp4_csf32.expand(t.f, t.rig.s, t.desc, t.out, t.plan, t.shape.n, t.shape.k, M, E, 4, false);
+        try check_.sameBytes("CSF empty route preserves scratch", try t.rig.outputBytes(), t.active);
+        try t.run();
+        try check_.sameBytes("CSF scratch reuse restores all experts", try t.rig.outputBytes(), t.want);
+        try check_.expect(try t.rig.intact(), "CSF expansion touched a guard", .{});
+    }
+};
+
+pub fn run(gpu: check_.Gpu) !void {
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var mod = try cuda.Module.load(gpu.d, cuda.kernels.nvfp4_experts);
+    defer mod.unload();
+    var test_: Test = .{ .rig = .{ .gpu = gpu, .s = stream }, .f = try mod.function("tf_nvfp4_csf32_expand") };
+    defer test_.deinit();
+    var tally: g.Tally = .{};
+    try g.runAll(gpu.gpa, &.{test_.kernel()}, 0x63736632, &tally);
+    try test_.routes();
+    std.debug.print("SUMMARY CSF32 byte expansion: {d} pass, {d} fail; active/duplicate/empty/reused scratch passed\n", .{ tally.passed, tally.failed });
+    try check_.expect(tally.problems() == 0, "CSF32 contract failures", .{});
+}
diff --git a/zig/tests/cuda/contract_nvfp4_separate.zig b/zig/tests/cuda/contract_nvfp4_separate.zig
new file mode 100644
index 00000000..8d271142
--- /dev/null
+++ b/zig/tests/cuda/contract_nvfp4_separate.zig
@@ -0,0 +1,235 @@
+//! The separate-storage expert consumers against identical-input legacy operators and FP64 stress sums.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const rig_ = @import("contract_rig.zig");
+const check_ = @import("check.zig");
+const c = core.contract.spec;
+const g = core.contract.gates;
+const X = cuda.experts.Nvfp4Experts;
+const E = 3;
+
+pub const Kind = enum { up, down_f32, down_bf16, relu2, prompt_up, prompt_down, prompt_relu2 };
+fn depth(s: c.Shape) usize {
+    return s.k + 8;
+}
+fn isUp(k: Kind) bool {
+    return k == .up or k == .relu2 or k == .prompt_up or k == .prompt_relu2;
+}
+fn isPrompt(k: Kind) bool {
+    return k == .prompt_up or k == .prompt_down or k == .prompt_relu2;
+}
+fn isRelu(k: Kind) bool {
+    return k == .relu2 or k == .prompt_relu2;
+}
+fn spec(kind: Kind) c.Spec {
+    return .{ .name = switch (kind) {
+        .up => "cuda separate NVFP4 decode up",
+        .down_f32 => "cuda separate NVFP4 decode f32 down",
+        .down_bf16 => "cuda separate NVFP4 decode bf16 down",
+        .relu2 => "cuda separate NVFP4 decode relu2",
+        .prompt_up => "cuda separate NVFP4 prompt up",
+        .prompt_down => "cuda separate NVFP4 prompt down",
+        .prompt_relu2 => "cuda separate NVFP4 prompt relu2",
+    }, .accum = .f32, .depth = depth, .ops = 4, .out = if (kind == .down_f32) .f32 else .bf16, .replaces = "legacy interleaved NVFP4 expert with identical arithmetic and launch grouping", .nan = .{ .stated = "byte-identical to legacy for NaN/infinite activations and global scales" }, .tiles = .{ .{ .size = if (isPrompt(kind)) 64 else 16 }, .{ .size = 256, .step = 32, .min = 32 }, .{ .size = 64, .step = 32, .min = 32 } }, .served = if (isUp(kind)) &.{ .{ .rows = 1, .n = 1024, .k = 4096 }, .{ .rows = 65, .n = 1024, .k = 4096 } } else &.{ .{ .rows = 1, .n = 4096, .k = 1024 }, .{ .rows = 65, .n = 4096, .k = 1024 } } };
+}
+
+pub const Test = struct {
+    rig: rig_.Rig,
+    kind: Kind,
+    kernels: *const X,
+    shape: c.Shape = undefined,
+    x: []u16 = &.{},
+    codes: []u8 = &.{},
+    scales: []u8 = &.{},
+    globals: [E * 2]f32 = @splat(1),
+    legacy: cuda.experts.Layer = undefined,
+    candidate: cuda.experts.Layer = undefined,
+    plan: cuda.grouped.Plan = undefined,
+    items: usize = 0,
+    xd: u64 = 0,
+    out: u64 = 0,
+    base: u64 = 0,
+
+    const vt = g.hooks(Test);
+
+    fn free(t: *Test) void {
+        const a = t.rig.gpu.gpa;
+        a.free(t.x);
+        a.free(t.codes);
+        a.free(t.scales);
+        t.x = &.{};
+        t.codes = &.{};
+        t.scales = &.{};
+    }
+    pub fn deinit(t: *Test) void {
+        t.free();
+        t.rig.deinit();
+    }
+    pub fn kernel(t: *Test) g.Kernel {
+        return .{ .spec = spec(t.kind), .ctx = t, .vt = &vt };
+    }
+    fn parts(t: *const Test) usize {
+        return if (isUp(t.kind) and !isRelu(t.kind)) 2 else 1;
+    }
+    pub fn count(t: *Test) usize {
+        return E * t.shape.rows * t.shape.n;
+    }
+    fn bytes(t: *Test) usize {
+        return t.count() * c.size(spec(t.kind).out);
+    }
+
+    pub fn prepare(t: *Test, s: c.Shape, fill: g.Fill, seed: u64) !bool {
+        if (s.rows == 0 or s.n == 0 or s.k == 0 or s.n % 32 != 0 or s.k % 32 != 0) return false;
+        t.free();
+        t.rig.reset();
+        t.shape = s;
+        const a = t.rig.gpu.gpa;
+        const m = t.parts();
+        const xr = s.rows * @as(usize, if (isUp(t.kind)) 1 else E);
+        t.x = try a.alloc(u16, xr * s.k);
+        t.codes = try a.alloc(u8, E * m * s.n * s.k / 2);
+        t.scales = try a.alloc(u8, E * m * s.n * s.k / 16);
+        var prng = std.Random.DefaultPrng.init(seed);
+        const rng = prng.random();
+        rng.bytes(t.codes);
+        @memset(t.scales, 0x38);
+        @memset(&t.globals, 1);
+        for (t.x) |*v| v.* = c.toBf16((@as(f32, @floatFromInt(rng.uintLessThan(u32, 65))) - 32) / 32);
+        if (fill == .stress) {
+            @memset(t.scales, 0x50);
+            for (0..xr) |r| for (0..s.k / 2) |i| {
+                const coarse: f32 = @as(f32, @floatFromInt(4 + 2 * rng.uintLessThan(u32, 2))) * 16;
+                const v = coarse + @as(f32, if (isUp(t.kind)) 0 else @floatFromInt(1 + rng.uintLessThan(u32, 8)));
+                t.x[r * s.k + i] = c.toBf16(v);
+                t.x[r * s.k + s.k / 2 + i] = c.toBf16(if (i < 8) v - @as(f32, if (isUp(t.kind)) 16 else 1) else v);
+            };
+            for (0..E * m * s.n) |r| for (0..s.k / 2) |i| {
+                const v: u8 = 6 + rng.uintLessThan(u8, 2);
+                put(t.codes[r * s.k / 2 ..], i, v);
+                put(t.codes[r * s.k / 2 ..], i + s.k / 2, v | 8);
+            };
+        } else if (fill == .nonfinite) {
+            t.x[0] = 0x7fc0;
+            t.x[3] = 0x7f80;
+            t.x[7] = 0xff80;
+            t.globals[0] = std.math.nan(f32);
+            t.globals[m] = std.math.inf(f32);
+        }
+        const words = X.bytes(E, s.n, s.k, m) / 4;
+        const native = try a.alloc(u32, words);
+        defer a.free(native);
+        const wb = s.n * s.k / 2;
+        const sb = s.n * s.k / 16;
+        for (0..E) |e| {
+            const at = e * m;
+            const dest = native[e * words / E ..][0 .. words / E];
+            if (m == 2) X.packGateUp(dest, .{ t.codes[at * wb ..][0..wb], t.scales[at * sb ..][0..sb] }, .{ t.codes[(at + 1) * wb ..][0..wb], t.scales[(at + 1) * sb ..][0..sb] }, s.n, s.k) else X.packOne(dest, t.codes[at * wb ..][0..wb], t.scales[at * sb ..][0..sb], s.n, s.k);
+        }
+        const separated = try cuda.nvfp4_separate.split(a, native);
+        defer separated.deinit(a);
+        const w = try t.rig.input(std.mem.sliceAsBytes(native));
+        const alpha = try t.rig.input(std.mem.sliceAsBytes(t.globals[0 .. E * m]));
+        t.legacy = .{ .format = .nvfp4, .up = w, .down = w, .up_scale = alpha, .down_scale = alpha, .width = if (isUp(t.kind)) s.n else s.k, .dims = if (isUp(t.kind)) s.k else s.n, .experts = E, .relu2 = isRelu(t.kind) };
+        t.candidate = t.legacy;
+        t.candidate.up = try t.rig.input(std.mem.sliceAsBytes(separated.codes));
+        t.candidate.down = t.candidate.up;
+        t.candidate.up_blocks = try t.rig.input(std.mem.sliceAsBytes(separated.scales));
+        t.candidate.down_blocks = t.candidate.up_blocks;
+        t.xd = try t.rig.input(std.mem.sliceAsBytes(t.x));
+        const tile: usize = if (isPrompt(t.kind)) 64 else 16;
+        t.items = E * ((s.rows + tile - 1) / tile);
+        const items = try a.alloc(i32, t.items * 3);
+        defer a.free(items);
+        const members = try a.alloc(i32, E * s.rows);
+        defer a.free(members);
+        var at: usize = 0;
+        for (0..E) |e| {
+            for (0..s.rows) |r| members[e * s.rows + r] = @intCast(r * E + e);
+            var row: usize = 0;
+            while (row < s.rows) : (row += tile) {
+                items[at * 3] = @intCast(e);
+                items[at * 3 + 1] = @intCast(e * s.rows + row);
+                items[at * 3 + 2] = @intCast(@min(tile, s.rows - row));
+                at += 1;
+            }
+        }
+        const counts = [2]i32{ @intCast(t.items), 0 };
+        t.plan = .{ .items = try t.rig.input(std.mem.sliceAsBytes(items)), .members = try t.rig.input(std.mem.sliceAsBytes(members)), .counts = try t.rig.input(std.mem.asBytes(&counts)), .rank = 0, .hist = 0 };
+        t.out = try t.rig.output(t.bytes());
+        t.base = try t.rig.scratch(t.bytes());
+        return true;
+    }
+    fn put(b: []u8, i: usize, v: u8) void {
+        if (i % 2 == 0) b[i / 2] = (b[i / 2] & 0xf0) | v else b[i / 2] = (b[i / 2] & 0x0f) | (v << 4);
+    }
+    fn launch(t: *Test, layer: cuda.experts.Layer, out: u64) !void {
+        const epi: cuda.experts.Epi = if (isUp(t.kind)) .up else if (t.kind == .down_f32) .down_f32 else .down_bf16;
+        const rows: cuda.experts.Rows = .{ .x = t.xd, .stride = t.shape.k, .slots = if (isUp(t.kind)) E else 0 };
+        if (isPrompt(t.kind)) try t.kernels.runPrompt(t.rig.s, epi, rows, layer, t.plan, out, t.items, -1) else try t.kernels.run(t.rig.s, epi, rows, layer, t.plan, out, t.items, -1);
+    }
+    pub fn run(t: *Test) !void {
+        try t.launch(t.candidate, t.out);
+    }
+    pub fn replaced(t: *Test) ![]const u8 {
+        try t.launch(t.legacy, t.base);
+        return t.rig.bytes(t.base, t.bytes());
+    }
+    pub fn check(t: *Test, gate: g.Gate) !?[]const u8 {
+        const got = try t.rig.outputBytes();
+        const want = try t.replaced();
+        if (!std.mem.eql(u8, got, want)) return "separate-storage bytes differ from legacy";
+        if (gate != .nonfinite) return null;
+        for (0..t.count()) |i| if (c.classOf(c.read(spec(t.kind).out, got, i)) != .finite) return null;
+        return "no planted non-finite output reached the consumer";
+    }
+    fn terms(t: *Test, p: usize, j: usize, part: usize, dst: []f64) void {
+        const k = t.shape.k;
+        const wr = ((p % E) * t.parts() + part) * t.shape.n + j;
+        const xr = if (isUp(t.kind)) p / E else p;
+        for (dst, 0..) |*v, i| {
+            const b = t.codes[wr * k / 2 + i / 2];
+            const nib = if (i % 2 == 0) b & 15 else b >> 4;
+            v.* = c.fromBf16(t.x[xr * k + i]) * core.quant.nvfp4.e2m1(nib) * core.quant.fp8.e4m3(t.scales[wr * k / 16 + i / 16]);
+        }
+    }
+    fn sums(t: *Test, acc: c.Accum, order: g.Order, out: []f64, mag: ?[]f64) !void {
+        const terms_ = try t.rig.gpu.gpa.alloc(f64, t.shape.k);
+        defer t.rig.gpu.gpa.free(terms_);
+        for (0..E * t.shape.rows) |p| for (0..t.shape.n) |j| {
+            var sums_: [2]f64 = @splat(0);
+            var magnitude: f64 = 0;
+            for (0..t.parts()) |part| {
+                t.terms(p, j, part, terms_);
+                sums_[part] = core.contract.rows.sumIn(acc, order, terms_) * t.globals[(p % E) * t.parts() + part];
+                for (terms_) |v| magnitude += @abs(v);
+            }
+            const v = sums_[0];
+            out[p * t.shape.n + j] = if (!isUp(t.kind)) v else if (isRelu(t.kind)) @max(v, 0) * @max(v, 0) else v / (1 + @exp(-v)) * sums_[1];
+            if (mag) |m| m[p * t.shape.n + j] = magnitude * (1 + @abs(v) + @abs(sums_[1]));
+        };
+    }
+    pub fn reference(t: *Test, want: []f64, mag: []f64) !void {
+        try t.sums(.none, .sequential, want, mag);
+    }
+    pub fn simulate(t: *Test, acc: c.Accum, order: g.Order, out: []f64) !void {
+        try t.sums(acc, order, out, null);
+    }
+};
+
+pub fn run(gpu: check_.Gpu) !void {
+    var stream = try cuda.Stream.init(gpu.d, false);
+    defer stream.deinit();
+    var tally: g.Tally = .{};
+    for ([_]usize{ 1, 4 }) |warps| {
+        var kernels = try X.loadWarps(gpu.d, @intCast(try gpu.ctx.attribute(.multiprocessor_count)), warps);
+        defer kernels.unload();
+        for (std.enums.values(Kind)) |kind| {
+            var t: Test = .{ .rig = .{ .gpu = gpu, .s = stream }, .kind = kind, .kernels = &kernels };
+            defer t.deinit();
+            try g.runAll(gpu.gpa, &.{t.kernel()}, 0x637366, &tally);
+        }
+    }
+    std.debug.print("SUMMARY separate NVFP4: {d} pass, {d} fail, {d} known; targeted gates, full runner required separately\n", .{ tally.passed, tally.failed, tally.known });
+    try check_.expect(tally.problems() == 0, "separate-storage contract failures", .{});
+}
