+// Exact csf_32x2_v1 expansion into the native expert scale swizzle; no floating-point conversion.
+#pragma once
+struct TfCsf32 {
+  const uint8_t *bases, *codes;
+  const uint32_t* pages;
+  const uint16_t *offsets, *exceptions;
+};
+static_assert(sizeof(TfCsf32) == 40);
+
+extern "C" __global__ void __launch_bounds__(128)
+tf_nvfp4_csf32_expand(const TfCsf32* __restrict__ desc, uint4* __restrict__ out,
+                     const int* __restrict__ items, const int* __restrict__ counts,
+                     int NB, int KG, int parts, int experts, int prompt) {
+  const int which = blockIdx.y / parts, part = blockIdx.y % parts;
+  int e = which;
+  if (!prompt) {
+    if (which >= __ldg(counts)) return;
+    e = __ldg(items + which * 3);
+    // Native grouped plans put an expert's consecutive chunks next to one another.
+    if (which && __ldg(items + (which - 1) * 3) == e) return;
+  }
+  if (e < 0 || e >= experts) return;
+  const int q = blockIdx.x * blockDim.x + threadIdx.x;
+  if (q >= NB * KG * 4) return;
+  const int tile = q / 4, vec = q % 4, row_block = tile / KG, col_pair = tile % KG;
+  const TfCsf32 p = desc[e * parts + part];
+  const int block = ((row_block / 4) * (KG / 2) + col_pair / 2) * 8 + (col_pair % 2) * 4 + row_block % 4;
+  uint32_t words[4] = {0,0,0,0};
+#pragma unroll
+  for (int h = 0; h < 2; ++h) {
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+#pragma unroll
+      for (int c = 0; c < 2; ++c) {
+        const int r = j * 8 + vec * 2 + c;
+        const uint8_t code = p.codes[(size_t)block * 32 + r];
+        const uint32_t value = uint32_t(p.bases[row_block * 32 + r]) + ((code >> (4*h)) & 15);
+        constexpr int bytes_per_word = 4;
+        const int b = (h * 4 + j) * 2 + c;
+        words[b / bytes_per_word] |= value << (8 * (b % bytes_per_word));
+      }
+    }
+  }
+  uint4 v = make_uint4(words[0],words[1],words[2],words[3]);
+  const int page = block / 256;
+  const uint32_t origin = p.pages[page] / 2;
+  const uint32_t lo = origin + p.offsets[block + page], hi = origin + p.offsets[block + page + 1];
+  for (uint32_t i = lo; i < hi; ++i) {
+    const uint16_t rec = p.exceptions[i];
+    const int r = (rec & 255) / 2, h = rec & 1;
+    if ((r % 8) / 2 != vec) continue;
+    const int b = (h * 4 + r / 8) * 2 + r % 2, shift = 8 * (b % 4);
+    const uint32_t mask = ~(255u << shift), value = uint32_t(rec >> 8) << shift;
+    switch (b / 4) {
+      case 0: v.x = (v.x & mask) | value; break;
+      case 1: v.y = (v.y & mask) | value; break;
+      case 2: v.z = (v.z & mask) | value; break;
+      default: v.w = (v.w & mask) | value;
+    }
+  }
+  out[((size_t)e * NB * KG + tile) * parts * 4 + part * 4 + vec] = v;
+}
