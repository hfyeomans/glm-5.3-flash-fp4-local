diff --git a/zig/src/core/nvfp4_csf32_slice.zig b/zig/src/core/nvfp4_csf32_slice.zig
new file mode 100644
index 00000000..38676a24
--- /dev/null
+++ b/zig/src/core/nvfp4_csf32_slice.zig
@@ -0,0 +1,94 @@
+//! Lossless aligned TP rectangles: retain row bases, nibbles and exceptions, rebuilding compact page indexes.
+const std = @import("std");
+const codec = @import("nvfp4_csf32.zig");
+
+fn u16at(b: []const u8, at: usize) usize {
+    return std.mem.readInt(u16, b[at * 2 ..][0..2], .little);
+}
+fn u32at(b: []const u8, at: usize) usize {
+    return std.mem.readInt(u32, b[at * 4 ..][0..4], .little);
+}
+fn w16(b: []u8, at: usize, v: usize) !void {
+    const n = std.math.cast(u16, v) orelse return error.CsfShape;
+    std.mem.writeInt(u16, b[at * 2 ..][0..2], n, .little);
+}
+fn w32(b: []u8, at: usize, v: usize) !void {
+    const n = std.math.cast(u32, v) orelse return error.CsfShape;
+    std.mem.writeInt(u32, b[at * 4 ..][0..4], n, .little);
+}
+
+/// Runtime geometry is deliberately narrower than the general codec: complete 128-row by 4-column tiles.
+pub fn slice(a: std.mem.Allocator, p: codec.Parts, rows: usize, cols: usize, rr: [2]usize, cc: [2]usize) !codec.Encoded {
+    if (rows == 0 or cols == 0 or rows % 128 != 0 or cols % 4 != 0 or rr[0] >= rr[1] or cc[0] >= cc[1] or
+        rr[1] > rows or cc[1] > cols or rr[0] % 128 != 0 or rr[1] % 128 != 0 or cc[0] % 4 != 0 or cc[1] % 4 != 0)
+        return error.CsfShape;
+    const extent = std.math.mul(usize, rows, cols) catch return error.CsfShape;
+    const decoded = try a.alloc(u8, extent);
+    defer a.free(decoded);
+    try codec.decode(p, rows, cols, decoded);
+    const nr = rr[1] - rr[0];
+    const nc = cc[1] - cc[0];
+    const blocks = nr / 32 * (nc / 2);
+    const pages = (blocks + 255) / 256;
+    const bases = try a.dupe(u8, p.bases[rr[0]..rr[1]]);
+    errdefer a.free(bases);
+    const codes = try a.alloc(u8, nr * nc / 2);
+    errdefer a.free(codes);
+    const page_bases = try a.alloc(u8, pages * 4);
+    errdefer a.free(page_bases);
+    const offsets = try a.alloc(u8, 2 * (blocks + pages));
+    errdefer a.free(offsets);
+    var exceptions: std.ArrayList(u8) = .empty;
+    errdefer exceptions.deinit(a);
+    var origin: usize = 0;
+    for (0..blocks) |b| {
+        const tile = b / 8;
+        const row = rr[0] + tile / (nc / 4) * 128 + (b % 4) * 32;
+        const col = cc[0] + tile % (nc / 4) * 4 + (b % 8 / 4) * 2;
+        const src = ((row / 128) * (cols / 4) + col / 4) * 8 + (col % 4 / 2) * 4 + (row % 128 / 32);
+        @memcpy(codes[b * 32 ..][0..32], p.codes[src * 32 ..][0..32]);
+        if (b % 256 == 0) {
+            origin = exceptions.items.len;
+            try w32(page_bases, b / 256, origin);
+            try w16(offsets, b + b / 256, 0);
+        }
+        const page = src / 256;
+        const lo = u32at(p.page_bases, page) + 2 * u16at(p.offsets, src + page);
+        const hi = u32at(p.page_bases, page) + 2 * u16at(p.offsets, src + page + 1);
+        try exceptions.appendSlice(a, p.exceptions[lo..hi]);
+        try w16(offsets, b + b / 256 + 1, (exceptions.items.len - origin) / 2);
+    }
+    return .{ .bases = bases, .codes = codes, .page_bases = page_bases, .offsets = offsets, .exceptions = try exceptions.toOwnedSlice(a) };
+}
+
+test "row and column cuts preserve every byte, retain original bases and regroup pages" {
+    const a = std.testing.allocator;
+    const rows = 256;
+    const cols = 128;
+    var values: [rows * cols]u8 = undefined;
+    for (&values, 0..) |*v, i| v.* = if (i % 17 == 0) @truncate(i * 13) else @intCast(48 + i % 16);
+    const original = try codec.encode(a, &values, rows, cols);
+    defer original.deinit(a);
+    for ([_][4]usize{ .{ 0, 128, 0, 128 }, .{ 128, 256, 0, 128 }, .{ 0, 256, 0, 64 }, .{ 0, 256, 64, 128 }, .{ 128, 256, 4, 12 } }) |cut| {
+        const r = try slice(a, original.parts(), rows, cols, .{ cut[0], cut[1] }, .{ cut[2], cut[3] });
+        defer r.deinit(a);
+        const nr = cut[1] - cut[0];
+        const nc = cut[3] - cut[2];
+        const got = try a.alloc(u8, nr * nc);
+        defer a.free(got);
+        try codec.decode(r.parts(), nr, nc, got);
+        try std.testing.expectEqualSlices(u8, original.bases[cut[0]..cut[1]], r.bases);
+        for (0..nr) |row| try std.testing.expectEqualSlices(u8, values[(row + cut[0]) * cols + cut[2] ..][0..nc], got[row * nc ..][0..nc]);
+    }
+}
+
+test "malformed input and unaligned geometry are refused before producing a slice" {
+    const a = std.testing.allocator;
+    var values: [128 * 64]u8 = @splat(0x38);
+    const p = try codec.encode(a, &values, 128, 64);
+    defer p.deinit(a);
+    try std.testing.expectError(error.CsfShape, slice(a, p.parts(), 128, 64, .{ 0, 32 }, .{ 0, 64 }));
+    try std.testing.expectError(error.CsfShape, slice(a, p.parts(), 128, 64, .{ 0, 128 }, .{ 2, 64 }));
+    p.bases[0] = 241;
+    try std.testing.expectError(error.CsfBase, slice(a, p.parts(), 128, 64, .{ 0, 128 }, .{ 0, 32 }));
+}
