@@ -0,0 +1,31 @@
+//! Every real resident-CSF layer expanded on GPU and compared with independently cut CPU checkpoint scales.
+const std = @import("std");
+const cuda = @import("cuda");
+const glm = @import("glm_cuda");
+const check = @import("check.zig");
+
+pub fn run(gpu: check.Gpu, m: *const glm.forward.Modules, stream: cuda.Stream, w: *const glm.weights.Weights, oracle: anytype) !void {
+    var matrices: usize = 0;
+    var bytes: usize = 0;
+    for (w.layers) |layer| {
+        if (layer.ffn != .moe) continue;
+        const l = layer.ffn.moe.routed;
+        if (l.up_csf == 0) continue;
+        for ([_]bool{ true, false }) |up| {
+            const want = try oracle.expected(layer.index, up);
+            defer gpu.gpa.free(want);
+            const ptr = if (up) l.up_blocks else l.down_blocks;
+            try cuda.nvfp4_csf32.expand(m.experts.nvfp4.separate.expand, stream, if (up) l.up_csf else l.down_csf, ptr, .{ .items = 0, .counts = 0, .members = 0, .rank = 0, .hist = 0 }, if (up) l.width else l.dims, if (up) l.dims else l.width, if (up) 2 else 1, l.experts, 0, true);
+            try stream.synchronize();
+            const got = try gpu.gpa.alloc(u8, want.len);
+            defer gpu.gpa.free(got);
+            try (cuda.DeviceBuffer{ .d = gpu.d, .ptr = ptr, .len = got.len }).download(0, got);
+            var label: [128]u8 = undefined;
+            try check.sameBytes(try std.fmt.bufPrint(&label, "CSF32 rank {d} layer {d} {s}", .{ w.share.rank, layer.index, if (up) "up" else "down" }), got, want);
+            matrices += l.experts * @as(usize, if (up) 2 else 1);
+            bytes += got.len;
+        }
+    }
+    try check.expect(matrices > 0, "no resident CSF32 matrices checked", .{});
+    std.debug.print("PASS CSF32 materialization rank {d}: {d} matrices, {d} expanded scale bytes match CPU/native oracle\n", .{ w.share.rank, matrices, bytes });
+}
diff --git a/zig/tests/cuda/glm_csf_scale_oracle.zig b/zig/tests/cuda/glm_csf_scale_oracle.zig
new file mode 100644
index 00000000..0f736e88
--- /dev/null
+++ b/zig/tests/cuda/glm_csf_scale_oracle.zig
@@ -0,0 +1,40 @@
+//! Real checkpoint CPU scales in the legacy swizzle, without needlessly repacking all weight-code nibbles.
+const std = @import("std");
+const core = @import("core");
+const glm = @import("glm_cuda");
+
+pub fn reference(a: std.mem.Allocator, ck: *core.Checkpoint, c: *const glm.config.Config, share: glm.shard.Share, layer: u32, up: bool) ![]u8 {
+    const cut = share.moe;
+    const d: usize = c.hidden;
+    const n = if (up) cut.len() else d;
+    const k = if (up) d else cut.len();
+    const parts: usize = if (up) 2 else 1;
+    const nb = n / 32;
+    const kg = k / 32;
+    const decoded = try a.alloc(u8, c.moe_inter * d / 16);
+    defer a.free(decoded);
+    const out = try a.alloc(u8, c.experts * nb * kg * parts * 64);
+    errdefer a.free(out);
+    for (0..c.experts) |e| for (0..parts) |part| {
+        const proj = if (!up) "down_proj" else if (part == 0) "gate_proj" else "up_proj";
+        var name: [256]u8 = undefined;
+        const module = try std.fmt.bufPrint(&name, "model.language_model.layers.{d}.mlp.experts.{d}.{s}", .{ layer, e, proj });
+        const lin = try glm.weights.formats.csfLinear(ck, module, decoded);
+        writeMatrix(out[e * nb * kg * parts * 64 ..][0 .. nb * kg * parts * 64], decoded, lin.k / 16, if (up) cut.lo else 0, if (up) 0 else cut.lo / 16, n, k, parts, part);
+    };
+    return out;
+}
+
+/// The original packer's scale swizzle, applied to a rectangle of CPU-decoded checkpoint bytes.
+pub fn writeMatrix(out: []u8, decoded: []const u8, src_cols: usize, row_start: usize, col_start: usize, n: usize, k: usize, parts: usize, part: usize) void {
+    const nb = n / 32;
+    const kg = k / 32;
+    std.debug.assert(out.len == nb * kg * parts * 64 and part < parts);
+    for (0..nb) |cb| for (0..kg) |g| {
+        const dest = out[((cb * kg + g) * parts + part) * 64 ..][0..64];
+        for (0..4) |t| for (0..2) |h| for (0..4) |j| for (0..2) |col| {
+            const row = row_start + cb * 32 + j * 8 + t * 2 + col;
+            dest[((t * 2 + h) * 4 + j) * 2 + col] = decoded[row * src_cols + col_start + g * 2 + h];
+        };
+    };
+}
