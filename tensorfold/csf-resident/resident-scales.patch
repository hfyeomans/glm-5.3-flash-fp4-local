+// Separate code and expanded-scale storage; arithmetic stays in the common expert templates.
+#pragma once
+#define TF_SEPARATE_ARGS \
+ const __nv_bfloat16* __restrict__ X, int stride, int slots, const uint4* __restrict__ W, \
+ const float* __restrict__ global, int KG, int NB, const int* __restrict__ items, \
+ const int* __restrict__ counts, const int* __restrict__ members, void* __restrict__ out, \
+ int N, float limit, int skip, const uint4* __restrict__ scales
+#define TF_SEPARATE_PASS X, stride, slots, W, global, KG, NB, items, counts, members, out, N, limit, skip, scales
+#define TF_SEPARATE_DECODE(NAME, M, EPI, WARPS) \
+ extern "C" __global__ void __launch_bounds__(WARPS * 32) NAME(TF_SEPARATE_ARGS) { \
+   tf_nvfp4_experts::expert_body<M, EPI, WARPS, true>(TF_SEPARATE_PASS); \
+ }
+#define TF_SEPARATE_PROMPT(NAME, M, EPI, WN) \
+ extern "C" __global__ void __launch_bounds__(WN * 32) NAME(TF_SEPARATE_ARGS) { \
+   tf_nvfp4_experts::prompt_body<M, EPI, 4, 1, WN, true>(TF_SEPARATE_PASS); \
+ }
+TF_SEPARATE_DECODE(tf_nvfp4_separate_up_w1, 2, 2, 1)
+TF_SEPARATE_DECODE(tf_nvfp4_separate_down_f32_w1, 1, 0, 1)
+TF_SEPARATE_DECODE(tf_nvfp4_separate_down_bf16_w1, 1, 3, 1)
+TF_SEPARATE_DECODE(tf_nvfp4_separate_relu2_w1, 1, 1, 1)
+TF_SEPARATE_DECODE(tf_nvfp4_separate_up_w4, 2, 2, 4)
+TF_SEPARATE_DECODE(tf_nvfp4_separate_down_f32_w4, 1, 0, 4)
+TF_SEPARATE_DECODE(tf_nvfp4_separate_down_bf16_w4, 1, 3, 4)
+TF_SEPARATE_DECODE(tf_nvfp4_separate_relu2_w4, 1, 1, 4)
+TF_SEPARATE_PROMPT(tf_nvfp4_separate_prompt_relu2_w8, 1, 1, 8)
+TF_SEPARATE_PROMPT(tf_nvfp4_separate_prompt_up_w4, 2, 2, 4)
+TF_SEPARATE_PROMPT(tf_nvfp4_separate_prompt_up_w8, 2, 2, 8)
+TF_SEPARATE_PROMPT(tf_nvfp4_separate_prompt_down_w8, 1, 3, 8)
+TF_SEPARATE_PROMPT(tf_nvfp4_separate_prompt_down_w16, 1, 3, 16)
+#undef TF_SEPARATE_ARGS
+#undef TF_SEPARATE_PASS
+#undef TF_SEPARATE_DECODE
+#undef TF_SEPARATE_PROMPT
