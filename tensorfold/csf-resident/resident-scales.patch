@@ -0,0 +1,109 @@
+//! TP2 resident CSF32 experts: codes-only uploads, one compact arena per layer, shared native scale scratch.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const formats = @import("cuda_formats.zig");
+const X = cuda.experts.Nvfp4Experts;
+const D = cuda.nvfp4_csf32.Descriptor;
+
+fn scratch(L: anytype, size: usize) !u64 {
+    var b = try cuda.DeviceBuffer.alloc(L.d, size);
+    errdefer b.free();
+    try L.w.buffers.append(L.gpa, b);
+    return b.ptr;
+}
+
+fn component(a: std.mem.Allocator, blob: *std.ArrayList(u8), bytes: []const u8) !u64 {
+    const pad = (16 - blob.items.len % 16) % 16;
+    try blob.appendNTimes(a, 0, pad);
+    const offset = blob.items.len;
+    try blob.appendSlice(a, bytes);
+    return @intCast(offset);
+}
+
+fn append(a: std.mem.Allocator, blob: *std.ArrayList(u8), p: core.nvfp4_csf32.Parts) !D {
+    return .{ .bases = try component(a, blob, p.bases), .codes = try component(a, blob, p.codes), .pages = try component(a, blob, p.page_bases), .offsets = try component(a, blob, p.offsets), .exceptions = try component(a, blob, p.exceptions) };
+}
+
+fn codesOnly(out: []u32, interleaved: []const u32) void {
+    std.debug.assert(interleaved.len % 144 == 0 and out.len == interleaved.len / 144 * 128);
+    for (0..interleaved.len / 144) |tile| @memcpy(out[tile * 128 ..][0..128], interleaved[tile * 144 ..][0..128]);
+}
+
+pub fn load(L: anytype, i: u32) !cuda.experts.Layer {
+    const a = L.gpa;
+    const c = &L.w.config;
+    const cut = L.w.share.moe;
+    if (L.w.share.world != 2 or c.hidden != 4096 or c.moe_inter != 2048 or c.experts != 288)
+        return error.UnsupportedCsfResidentGeometry;
+    const n = cut.len();
+    const d: usize = c.hidden;
+    const count: usize = c.experts;
+    const tiles = n / 32 * (d / 32);
+    const up = try a.alloc(u32, count * tiles * 2 * 128);
+    defer a.free(up);
+    const down = try a.alloc(u32, count * tiles * 128);
+    defer a.free(down);
+    const tmp = try a.alloc(u32, tiles * 2 * 144);
+    defer a.free(tmp);
+    const global_up = try a.alloc(f32, count * 2);
+    defer a.free(global_up);
+    const global_down = try a.alloc(f32, count);
+    defer a.free(global_down);
+    const du = try a.alloc(D, count * 2);
+    defer a.free(du);
+    const dd = try a.alloc(D, count);
+    defer a.free(dd);
+    var blob: std.ArrayList(u8) = .empty;
+    defer blob.deinit(a);
+    const per = c.moe_inter * d / 16;
+    const decoded = try a.alloc(u8, per * 3);
+    defer a.free(decoded);
+    const down_codes = try a.alloc(u8, d * n / 2);
+    defer a.free(down_codes);
+    const down_scales = try a.alloc(u8, d * n / 16);
+    defer a.free(down_scales);
+    for (0..count) |e| {
+        var ls: [3]core.nvfp4.Linear = undefined;
+        inline for (.{ "gate_proj", "up_proj", "down_proj" }, 0..) |proj, m| {
+            const name = try std.fmt.bufPrint(&L.name_buf, "model.language_model.layers.{d}.mlp.experts.{d}." ++ proj, .{ i, e });
+            try L.formatIn(L.ck, name, .nvfp4_csf);
+            ls[m] = try formats.csfLinear(L.ck, name, decoded[m * per ..][0..per]);
+            const src = try formats.csfParts(L.ck, name);
+            const rr: [2]usize = if (m == 2) .{ 0, d } else .{ cut.lo, cut.hi };
+            const cc: [2]usize = if (m == 2) .{ cut.lo / 16, cut.hi / 16 } else .{ 0, d / 16 };
+            const sliced = try core.nvfp4_csf32_slice.slice(a, src, ls[m].n, ls[m].k / 16, rr, cc);
+            defer sliced.deinit(a);
+            const desc = try append(a, &blob, sliced.parts());
+            if (m == 2) dd[e] = desc else du[e * 2 + m] = desc;
+        }
+        X.packGateUp(tmp, .{ ls[0].codes[cut.lo * d / 2 ..][0 .. n * d / 2], ls[0].scales[cut.lo * d / 16 ..][0 .. n * d / 16] }, .{ ls[1].codes[cut.lo * d / 2 ..][0 .. n * d / 2], ls[1].scales[cut.lo * d / 16 ..][0 .. n * d / 16] }, n, d);
+        codesOnly(up[e * tiles * 2 * 128 ..][0 .. tiles * 2 * 128], tmp);
+        for (0..d) |r| {
+            @memcpy(down_codes[r * n / 2 ..][0 .. n / 2], ls[2].codes[r * ls[2].k / 2 + cut.lo / 2 ..][0 .. n / 2]);
+            @memcpy(down_scales[r * n / 16 ..][0 .. n / 16], ls[2].scales[r * ls[2].k / 16 + cut.lo / 16 ..][0 .. n / 16]);
+        }
+        X.packOne(tmp[0 .. tiles * 144], down_codes, down_scales, d, n);
+        codesOnly(down[e * tiles * 128 ..][0 .. tiles * 128], tmp[0 .. tiles * 144]);
+        global_up[e * 2] = ls[0].global;
+        global_up[e * 2 + 1] = ls[1].global;
+        global_down[e] = ls[2].global;
+    }
+    try L.host.appendSlice(a, blob.items);
+    const arena = try L.put("layers.{d}.moe.experts.csf_arena", .{i});
+    for ([_][]D{ du, dd }) |descs| for (descs) |*desc| {
+        inline for (comptime std.meta.fieldNames(D)) |name| @field(desc, name) += arena;
+    };
+    var ptr: [6]u64 = undefined;
+    for (&ptr, [_][]const u8{ std.mem.sliceAsBytes(up), std.mem.sliceAsBytes(down), std.mem.sliceAsBytes(global_up), std.mem.sliceAsBytes(global_down), std.mem.sliceAsBytes(du), std.mem.sliceAsBytes(dd) }, [_][]const u8{ "up", "down", "up_scale", "down_scale", "up_csf", "down_csf" }) |*p, bytes, name| {
+        try L.host.appendSlice(a, bytes);
+        p.* = try L.put("layers.{d}.moe.experts.{s}", .{ i, name });
+    }
+    if (L.w.csf_scratch[0] == 0) {
+        L.w.csf_scratch[0] = try scratch(L, count * tiles * 2 * 64);
+        L.w.csf_scratch[1] = try scratch(L, count * tiles * 64);
+        std.log.info("resident CSF32 scale scratch per rank: up={d} down={d} bytes", .{ count * tiles * 2 * 64, count * tiles * 64 });
+    }
+    std.log.info("resident CSF32 layer {d}: codes={d} compressed={d} descriptors={d} bytes", .{ i, (up.len + down.len) * 4, blob.items.len, (du.len + dd.len) * @sizeOf(D) });
+    return .{ .format = .nvfp4, .up = ptr[0], .down = ptr[1], .up_scale = ptr[2], .down_scale = ptr[3], .up_blocks = L.w.csf_scratch[0], .down_blocks = L.w.csf_scratch[1], .up_csf = ptr[4], .down_csf = ptr[5], .width = n, .dims = d, .experts = count, .limit = c.swiglu_limit };
+}
