diff --git a/zig/src/cuda/nvfp4_csf32.zig b/zig/src/cuda/nvfp4_csf32.zig
new file mode 100644
index 00000000..6fe1a321
--- /dev/null
+++ b/zig/src/cuda/nvfp4_csf32.zig
@@ -0,0 +1,30 @@
+//! Typed compressed descriptors and ordered expansion into caller-owned native scale scratch.
+const std = @import("std");
+const Function = @import("module.zig").Function;
+const Stream = @import("stream.zig").Stream;
+const launch = @import("launch.zig");
+const Plan = @import("grouped.zig").Plan;
+
+pub const Descriptor = extern struct {
+    bases: u64,
+    codes: u64,
+    pages: u64,
+    offsets: u64,
+    exceptions: u64,
+};
+
+pub fn expand(f: Function, stream: Stream, descriptors: u64, out: u64, plan: Plan, n: usize, k: usize, parts: usize, experts: usize, items: usize, prompt: bool) !void {
+    if (descriptors == 0 or out == 0 or n == 0 or k == 0 or n % 128 != 0 or k % 64 != 0 or
+        (parts != 1 and parts != 2) or experts == 0) return error.CsfGeometry;
+    const y = (if (prompt) experts else items) * parts;
+    if (y == 0) return;
+    var args: launch.Args = .{};
+    for ([_]u64{ descriptors, out, plan.items, plan.counts }) |p| args.add(p);
+    for ([_]usize{ n / 32, k / 32, parts, experts, @intFromBool(prompt) }) |v| args.add(@as(i32, @intCast(v)));
+    try launch.launch(f, .{ .grid = .{ .x = @intCast((n / 32 * (k / 32) * 4 + 127) / 128), .y = @intCast(y) }, .block = .{ .x = 128 } }, stream, &args);
+}
+
+test "descriptor ABI is five 64-bit addresses" {
+    try std.testing.expectEqual(@as(usize, 40), @sizeOf(Descriptor));
+    try std.testing.expectEqual(@as(usize, 32), @offsetOf(Descriptor, "exceptions"));
+}
diff --git a/zig/src/cuda/nvfp4_separate.zig b/zig/src/cuda/nvfp4_separate.zig
new file mode 100644
index 00000000..812482e0
--- /dev/null
+++ b/zig/src/cuda/nvfp4_separate.zig
@@ -0,0 +1,81 @@
+//! Code/scale storage separation with the original native tile swizzle and arithmetic.
+const std = @import("std");
+const Module = @import("module.zig").Module;
+const Function = @import("module.zig").Function;
+
+pub const Kernels = struct {
+    expand: Function,
+    decode: [4]Function,
+    resident: [4]usize,
+    prompt: [3]Function,
+
+    pub fn load(mod: Module, sms: usize, warps: usize, widths: [3]usize) !Kernels {
+        var out: Kernels = undefined;
+        out.expand = try mod.function("tf_nvfp4_csf32_expand");
+        var buf: [128]u8 = undefined;
+        for ([_][]const u8{ "up", "down_f32", "down_bf16", "relu2" }, 0..) |kind, i| {
+            const name = try std.fmt.bufPrintSentinel(&buf, "tf_nvfp4_separate_{s}_w{d}", .{ kind, warps }, 0);
+            out.decode[i] = try mod.function(name);
+            out.resident[i] = @max(1, try out.decode[i].occupancy(@intCast(warps * 32), 0)) * sms;
+        }
+        for ([_][]const u8{ "relu2", "up", "down" }, widths, 0..) |kind, wn, i| {
+            const name = try std.fmt.bufPrintSentinel(&buf, "tf_nvfp4_separate_prompt_{s}_w{d}", .{ kind, wn }, 0);
+            out.prompt[i] = try mod.function(name);
+            const stage: u32 = @intCast((64 * 8 + wn * 2 * @as(usize, if (i == 1) 2 else 1) * 36) * 16);
+            const stages: u32 = if (stage * 4 <= 49152) 4 else if (stage * 3 <= 49152) 3 else 2;
+            try out.prompt[i].allowDynamicShared(stage * stages);
+        }
+        return out;
+    }
+};
+
+pub const Split = struct {
+    codes: []u32,
+    scales: []u32,
+
+    pub fn deinit(s: Split, a: std.mem.Allocator) void {
+        a.free(s.codes);
+        a.free(s.scales);
+    }
+};
+
+/// Deinterleave native 144-word tiles, without decoding or changing any byte.
+pub fn split(a: std.mem.Allocator, interleaved: []const u32) !Split {
+    if (interleaved.len == 0 or interleaved.len % 144 != 0) return error.InvalidPackedExtent;
+    const tiles = interleaved.len / 144;
+    const codes = try a.alloc(u32, tiles * 128);
+    errdefer a.free(codes);
+    const scales = try a.alloc(u32, tiles * 16);
+    for (0..tiles) |t| {
+        @memcpy(codes[t * 128 ..][0..128], interleaved[t * 144 ..][0..128]);
+        @memcpy(scales[t * 16 ..][0..16], interleaved[t * 144 + 128 ..][0..16]);
+    }
+    return .{ .codes = codes, .scales = scales };
+}
+
+test "separation preserves arbitrary code and scale bits across expert and projection boundaries" {
+    var interleaved: [144 * 6]u32 = undefined;
+    for (&interleaved, 0..) |*v, i| v.* = @truncate(i * 0x9e3779b9);
+    const s = try split(std.testing.allocator, &interleaved);
+    defer s.deinit(std.testing.allocator);
+    for (0..6) |t| {
+        try std.testing.expectEqualSlices(u32, interleaved[t * 144 ..][0..128], s.codes[t * 128 ..][0..128]);
+        try std.testing.expectEqualSlices(u32, interleaved[t * 144 + 128 ..][0..16], s.scales[t * 16 ..][0..16]);
+    }
+    try std.testing.expectEqual(interleaved.len, s.codes.len + s.scales.len);
+    try std.testing.expectError(error.InvalidPackedExtent, split(std.testing.allocator, &.{}));
+    try std.testing.expectError(error.InvalidPackedExtent, split(std.testing.allocator, interleaved[0..143]));
+}
+
+pub fn promptSmem(parts: usize, wn: usize) u32 {
+    const stage: u32 = @intCast((64 * 8 + wn * 2 * parts * 36) * 16);
+    const stages: u32 = if (stage * 4 <= 49152) 4 else if (stage * 3 <= 49152) 3 else 2;
+    return stages * stage;
+}
+
+pub fn decodeWarps(value: ?[]const u8) !usize {
+    const v = value orelse return 4;
+    if (std.mem.eql(u8, v, "1")) return 1;
+    if (std.mem.eql(u8, v, "4")) return 4;
+    return error.BadExpertWarps;
+}
