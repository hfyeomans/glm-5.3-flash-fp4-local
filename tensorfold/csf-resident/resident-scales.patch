+const X = cuda.experts.Nvfp4Experts;
+const E = 3;
+const M = 2;
+fn depth(_: c.Shape) usize {
+    return 0;
+}
+const spec: c.Spec = .{ .name = "cuda CSF32 native scale bytes", .accum = .none, .depth = depth, .out = .raw, .nan = .{ .stated = "all E4M3 encodings, including signed zero and NaN, preserve their exact bytes" }, .replaces = "CPU CSF32 decoder followed by legacy native scale packing", .tiles = .{ .{ .size = 1 }, .{ .size = 256, .step = 128, .min = 128 }, .{ .size = 128, .step = 64, .min = 64 } }, .served = &.{ .{ .rows = 1, .n = 1024, .k = 4096 }, .{ .rows = 1, .n = 4096, .k = 1024 } } };
