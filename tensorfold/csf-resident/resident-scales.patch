+    plan: cuda.grouped.Plan = undefined,
+    want: []u8 = &.{},
+    active: []u8 = &.{},
+    const vt = g.hooks(Test);
+    fn kernel(t: *Test) g.Kernel {
+        return .{ .spec = spec, .ctx = t, .vt = &vt };
+    }
+    fn deinit(t: *Test) void {
+        t.rig.gpu.gpa.free(t.want);
+        t.rig.gpu.gpa.free(t.active);
+        t.rig.deinit();
+    }
+    pub fn prepare(t: *Test, s: c.Shape, _: g.Fill, seed: u64) !bool {
+        if (s.n == 0 or s.k == 0 or s.n % 128 != 0 or s.k % 64 != 0) return false;
