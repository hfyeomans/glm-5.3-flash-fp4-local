+//! Upload codes and block scales separately; MTP and non-experimental callers keep their legacy layout.
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub fn upload(L: anytype, i: u32, up: []const u32, down: []const u32, up_global: []const f32, down_global: []const f32) !cuda.experts.Layer {
+    const u = try cuda.nvfp4_separate.split(L.gpa, up);
+    defer u.deinit(L.gpa);
+    const d = try cuda.nvfp4_separate.split(L.gpa, down);
+    defer d.deinit(L.gpa);
+    var ptrs: [6]u64 = undefined;
+    const arrays = [_][]const u8{ std.mem.sliceAsBytes(u.codes), std.mem.sliceAsBytes(d.codes), std.mem.sliceAsBytes(up_global), std.mem.sliceAsBytes(down_global), std.mem.sliceAsBytes(u.scales), std.mem.sliceAsBytes(d.scales) };
+    for (&ptrs, arrays, [_][]const u8{ "up", "down", "up_scale", "down_scale", "up_blocks", "down_blocks" }) |*p, bytes, name| {
+        try L.host.appendSlice(L.gpa, bytes);
+        p.* = try L.put("layers.{d}.moe.experts.{s}", .{ i, name });
+    }
+    return .{ .format = .nvfp4, .up = ptrs[0], .down = ptrs[1], .up_scale = ptrs[2], .down_scale = ptrs[3], .up_blocks = ptrs[4], .down_blocks = ptrs[5], .width = L.w.share.moe.len(), .dims = L.w.config.hidden, .experts = L.w.config.experts, .limit = L.w.config.swiglu_limit };
+}
