# Copy to tensorfold/.env. Literal unquoted KEY=VALUE; shell environment wins.
# HF_TOKEN is a credential, not a model location. Offline inference needs no token.
HF_CACHE_ROOT=/models_engrams/huggingface
MODEL_DIR=
TF_IMAGE=glm53-fp4-tensorfold:1.1.3-pr1050-sm120-context
TF_CONTAINER=glm53-fp4-tensorfold
TF_VOLUME=glm53-fp4-tensorfold-pr1050
TF_GPUS=0,1
TF_HOST=0.0.0.0
TF_PORT=8001
TF_COMM_PORT=29600
# Initial qualification envelope, not a measured limit. Grow after a passing run.
TF_CONTEXT=8192
TF_PARALLEL=1
TF_MODEL_NAME=glm-5.3-flash-fp4-local
BUILD_JOBS=4
# Device prompt-cache budget; 0 frees its storage for longer active contexts.
TF_PROMPT_CACHE_GIB=1
# Empty retains native default max(1 GiB, total/32), about 3 GiB on these cards.
TF_MEMORY_RESERVE_GIB=
# Profiling adds timing overhead; use 0 for throughput comparisons.
TF_PROFILE=0
TF_NCCL_DEBUG=WARN

# Measured SM120 choice; 4 restores the upstream default / historical ladder.
TF_NVFP4_DECODE_WARPS=1
